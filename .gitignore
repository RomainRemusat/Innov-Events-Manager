# =========================================================================
# GESTION DES EXCLUSIONS GIT - PROJET INNOV'EVENTS MANAGER (ECF CDA)
# =========================================================================

# --- Dépendances tiers ---
vendor/
node_modules/

# --- Secrets & Environnement (Sécurité OWASP - Ne jamais versionner !) ---
.env

# --- Outils de conteneurisation & Données locales Docker ---
.docker/

# --- Fichiers journaux d'exécution ---
*.log

# --- Fichiers résiduels systèmes (OS) ---
.DS_Store
Thumbs.db

# --- Configurations locales d'IDE ---
.idea/
.vscode/
.ai/
.junie/

# --- Gestion des médias publics (public/uploads/) ---
# On ignore les futurs uploads dynamiques des utilisateurs...
/public/uploads/events/*
# ... MAIS on conserve l'arborescence et les 2 images requises par le jeu d'essai initial (fixtures SQL)
!/public/uploads/events/.gitkeep
!/public/uploads/events/event_5c6c4886f81713243caf.png
!/public/uploads/events/event_9ca27f2ed5a2d0a0267f.png

/public/pdfs/
!/public/pdfs/.gitkeep

# --- Zone de stockage sécurisée des devis (storage/devis/) ---
# Zone privée hors webroot. On ignore les PDF commerciaux générés...
/storage/devis/*.pdf
# ... MAIS on force la présence du dossier sur le dépôt Git
!/storage/devis/.gitkeep

# --- Rapports d'analyse et de tests (AT3) ---
/tests/report/

# --- Bases de données temporaires locales ---
*.sqlite
*.sqlite-journal
# Documents de travail locaux
/docs/AUDIT_*
