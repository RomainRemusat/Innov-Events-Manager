# Interdire l'exécution de scripts dans le dossier des uploads (Sécurité OWASP CWE-434)
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|phar|inc|cgi|pl|py|sh|bash|exe|asp|aspx|jsp)$">
    Require all denied
</FilesMatch>

Options -ExecCGI -Indexes
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
